DEBUT(LANG='EN')
# Modal convergence study, generated by make_modal_case.py (quad=False)
MAIL0 = LIRE_MAILLAGE(FORMAT='MED', UNITE=20)
MAIL0 = DEFI_GROUP(reuse=MAIL0, MAILLAGE=MAIL0, CREA_GROUP_MA=(
    _F(NOM='G_TETRA', TOUT='OUI', TYPE_MAILLE='TETRA4'),
    _F(NOM='G_MOTEUR', OPTION='SPHERE', TYPE_MAILLE='TETRA4', POINT=(23.093853, -45.158407, 163.598992), RAYON=30.0, CRIT_NOEUD='MAJORITE'),
    _F(NOM='G_BASE_ELEC', OPTION='SPHERE', TYPE_MAILLE='TETRA4', POINT=(24.323447, 9.996963, 52.04348), RAYON=45.0, CRIT_NOEUD='MAJORITE'),
    _F(NOM='G_MASSES', UNION=('G_MOTEUR', 'G_BASE_ELEC')),
    _F(NOM='G_PETGCF', DIFFE=('G_TETRA', 'G_MASSES')),
))
MAIL = MAIL0

MODELE = AFFE_MODELE(MAILLAGE=MAIL, AFFE=_F(GROUP_MA='G_TETRA', PHENOMENE='MECANIQUE', MODELISATION='3D'))
PETGCF = DEFI_MATERIAU(ELAS=_F(E=6000.0, NU=0.35, RHO=1.3e-09))
PMOT = DEFI_MATERIAU(ELAS=_F(E=6000.0, NU=0.35, RHO=2.0760594270412793e-09))
PELE = DEFI_MATERIAU(ELAS=_F(E=6000.0, NU=0.35, RHO=2.1779379513216268e-09))
CHMAT = AFFE_MATERIAU(MAILLAGE=MAIL, AFFE=(
    _F(GROUP_MA='G_PETGCF', MATER=PETGCF), _F(GROUP_MA='G_MOTEUR', MATER=PMOT), _F(GROUP_MA='G_BASE_ELEC', MATER=PELE)))
ASSEMBLAGE(MODELE=MODELE, CHAM_MATER=CHMAT, NUME_DDL=CO('NUMEDDL'), MATR_ASSE=(
    _F(MATRICE=CO('RIGI'), OPTION='RIGI_MECA'), _F(MATRICE=CO('MASS'), OPTION='MASS_MECA')))
MODES = CALC_MODES(MATR_RIGI=RIGI, MATR_MASS=MASS, OPTION='BANDE', TYPE_RESU='DYNAMIQUE',
                   CALC_FREQ=_F(FREQ=(1.0, 320.0)), VERI_MODE=_F(STOP_ERREUR='NON'))
MASSE = POST_ELEM(MODELE=MODELE, CHAM_MATER=CHMAT, MASS_INER=_F(TOUT='OUI'))
IMPR_TABLE(TABLE=MASSE, UNITE=8)
TF = RECU_TABLE(CO=MODES, NOM_PARA=('NUME_MODE', 'FREQ'))
IMPR_TABLE(TABLE=TF, UNITE=8)
FIN()
