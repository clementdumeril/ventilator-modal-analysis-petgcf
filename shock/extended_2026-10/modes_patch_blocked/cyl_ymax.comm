DEBUT(LANG='FR')
# Generated by make_cases_modes_bc.py from carter_choc_cyl_ymax.comm

# Etude de chute sur carter cylindrique - Niveau 2
# Impact lateral sur le cote Y+ du carter cylindrique
# Dynamique transitoire elastique avec impact idealise par une impulsion.
# Unites: mm, tonne, N, s, MPa.

MAIL = LIRE_MAILLAGE(FORMAT='MED', UNITE=20)

MAIL = DEFI_GROUP(
    reuse=MAIL,
    MAILLAGE=MAIL,
    INFO=1,
    CREA_GROUP_MA=(
        _F(NOM='G_TETRA', TOUT='OUI', TYPE_MAILLE='TETRA4'),
        _F(
            NOM='G_MOTEUR',
            OPTION='SPHERE',
            TYPE_MAILLE='TETRA4',
            POINT=(23.093853, -45.158407, 163.598992),
            RAYON=30.0,
            CRIT_NOEUD='MAJORITE',
        ),
        _F(
            NOM='G_BASE_ELEC',
            OPTION='SPHERE',
            TYPE_MAILLE='TETRA4',
            POINT=(24.323447, 9.996963, 52.043480),
            RAYON=45.0,
            CRIT_NOEUD='MAJORITE',
        ),
        _F(
            NOM='G_MASSES_AJOUTEES',
            UNION=('G_MOTEUR', 'G_BASE_ELEC'),
            TYPE_MAILLE='TETRA4',
        ),
        _F(
            NOM='G_PETGCF',
            DIFFE=('G_TETRA', 'G_MASSES_AJOUTEES'),
            TYPE_MAILLE='TETRA4',
        ),
    ),
    CREA_GROUP_NO=(
        _F(
            NOM='N_CONTACT',
            OPTION='PLAN',
            POINT=(0.0, 102.879253, 0.0),
            VECT_NORMALE=(0.0, 1.0, 0.0),
            PRECISION=5.0,
        )
    ),
)

MODELE = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=_F(
        GROUP_MA='G_TETRA',
        PHENOMENE='MECANIQUE',
        MODELISATION='3D',
    ),
)

PETGCF = DEFI_MATERIAU(
    ELAS=_F(
        E=6000.0,
        NU=0.35,
        RHO=1.30e-9,
    )
)

PETGCF_MOTEUR = DEFI_MATERIAU(
    ELAS=_F(
        E=6000.0,
        NU=0.35,
        RHO=2.063354290143e-9,
    )
)

PETGCF_BASE_ELEC = DEFI_MATERIAU(
    ELAS=_F(
        E=6000.0,
        NU=0.35,
        RHO=2.160457338233e-9,
    )
)

CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(
        _F(GROUP_MA='G_PETGCF', MATER=PETGCF),
        _F(GROUP_MA='G_MOTEUR', MATER=PETGCF_MOTEUR),
        _F(GROUP_MA='G_BASE_ELEC', MATER=PETGCF_BASE_ELEC),
    ),
)

# Approximation conservative du contact:
# la petite zone de contact cylindrique est bloque en translation.
BC_CONTACT = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='N_CONTACT',
        DX=0.0,
        DY=0.0,
        DZ=0.0,
    ),
)


ASSEMBLAGE(MODELE=MODELE, CHAM_MATER=CHMAT, CHARGE=BC_CONTACT, NUME_DDL=CO('NUMEDDL'),
           MATR_ASSE=(_F(MATRICE=CO('RIGI'), OPTION='RIGI_MECA'), _F(MATRICE=CO('MASS'), OPTION='MASS_MECA')))
MODES = CALC_MODES(MATR_RIGI=RIGI, MATR_MASS=MASS, OPTION='PLUS_PETITE', TYPE_RESU='DYNAMIQUE',
                   CALC_FREQ=_F(NMAX_FREQ=6), VERI_MODE=_F(STOP_ERREUR='NON'))
TF = RECU_TABLE(CO=MODES, NOM_PARA=('NUME_MODE', 'FREQ'))
IMPR_TABLE(TABLE=TF, UNITE=8)
FIN()
