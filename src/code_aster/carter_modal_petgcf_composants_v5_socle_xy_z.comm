DEBUT(LANG='FR')

MAIL = LIRE_MAILLAGE(FORMAT='MED', UNITE=20)

# Version V5: vrai socle sur le plan XY et hauteur du ventilateur selon +Z.
# Transformation depuis la V4:
# x5 = x4 ; y5 = z4 ; z5 = -y4.
MAIL = DEFI_GROUP(
    reuse=MAIL,
    MAILLAGE=MAIL,
    CREA_GROUP_MA=(
        _F(
            NOM='G_TETRA',
            TOUT='OUI',
            TYPE_MAILLE='TETRA4',
        ),
        _F(
            NOM='G_MOTEUR',
            OPTION='SPHERE',
            TYPE_MAILLE='TETRA4',
            POINT=(23.093853, -45.158407, 163.598992),
            RAYON=30.0,
            CRIT_NOEUD='MAJORITE',
        ),
        _F(
            NOM='G_BASE_ELEC',
            OPTION='SPHERE',
            TYPE_MAILLE='TETRA4',
            POINT=(24.323447, 9.996963, 52.043480),
            RAYON=45.0,
            CRIT_NOEUD='MAJORITE',
        ),
        _F(
            NOM='G_MASSES_AJOUTEES',
            UNION=('G_MOTEUR', 'G_BASE_ELEC'),
            TYPE_MAILLE='TETRA4',
        ),
        _F(
            NOM='G_PETGCF',
            DIFFE=('G_TETRA', 'G_MASSES_AJOUTEES'),
            TYPE_MAILLE='TETRA4',
        ),
    ),
)

MODELE = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=_F(
        GROUP_MA='G_TETRA',
        PHENOMENE='MECANIQUE',
        MODELISATION='3D',
    ),
)

PETGCF = DEFI_MATERIAU(
    ELAS=_F(
        E=6000.0,
        NU=0.35,
        RHO=1.30e-9,
    )
)

PETGCF_MOTEUR = DEFI_MATERIAU(
    ELAS=_F(
        E=6000.0,
        NU=0.35,
        RHO=2.063354290143e-9,
    )
)

PETGCF_BASE_ELEC = DEFI_MATERIAU(
    ELAS=_F(
        E=6000.0,
        NU=0.35,
        RHO=2.160457338233e-9,
    )
)

CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            GROUP_MA='G_PETGCF',
            MATER=PETGCF,
        ),
        _F(
            GROUP_MA='G_MOTEUR',
            MATER=PETGCF_MOTEUR,
        ),
        _F(
            GROUP_MA='G_BASE_ELEC',
            MATER=PETGCF_BASE_ELEC,
        ),
    ),
)

ASSEMBLAGE(
    MODELE=MODELE,
    CHAM_MATER=CHMAT,
    NUME_DDL=CO('NUMEDDL'),
    MATR_ASSE=(
        _F(MATRICE=CO('RIGI'), OPTION='RIGI_MECA'),
        _F(MATRICE=CO('MASS'), OPTION='MASS_MECA'),
    ),
)

MODES = CALC_MODES(
    MATR_RIGI=RIGI,
    MATR_MASS=MASS,
    OPTION='BANDE',
    TYPE_RESU='DYNAMIQUE',
    CALC_FREQ=_F(FREQ=(1.0, 1500.0)),
    VERI_MODE=_F(STOP_ERREUR='NON'),
)

IMPR_RESU(
    FORMAT='MED',
    UNITE=80,
    RESU=_F(RESULTAT=MODES),
)

FIN()
